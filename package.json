{
  "name": "@grom.js/bot-api-spec",
  "type": "module",
  "version": "0.12.0",
  "packageManager": "pnpm@12.16.1",
  "description": "Telegram Bot API specification as a collection of JavaScript objects in a custom format.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grom-dev/bot-api-spec.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    }
  },
  "files": [
    "./dist/",
    "./src/"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --build --noEmit",
    "build": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gen": "node ./scripts/generate/main.ts all",
    "gen:fetch": "node ./scripts/generate/main.ts fetch",
    "gen:check": "node ./scripts/generate/main.ts check",
    "gen:build": "node ./scripts/generate/main.ts build",
    "gen:diff": "git diff --word-diff -- spec/upstream",
    "deps": "taze --write --interactive --include-locked minor",
    "release": "bumpp"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@types/node": "26.6.6",
    "@types/turndown": "5.0.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "bumpp": "12.3.0",
    "cheerio": "1.2.0",
    "domhandler": "6.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-format": "2.0.1",
    "taze": "21.3.0",
    "turndown": "7.2.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "zod": "4.6.7"
  }
}
