  "fields": [
    {
      "name": "type",
      "rawType": "String",
      "required": true,
      "description": "Type of the area, always “location”"
    },
    {
      "name": "latitude",
      "rawType": "Float",
      "required": true,
      "description": "Location latitude in degrees"
    },
    {
      "name": "longitude",
      "rawType": "Float",
      "required": true,
      "description": "Location longitude in degrees"
    },
    {
      "name": "address",
      "rawType": "LocationAddress",
      "required": false,
      "description": "Address of the location"
    }
  ]
}
