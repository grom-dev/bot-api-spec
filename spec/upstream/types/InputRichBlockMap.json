{
  "name": "InputRichBlockMap",
  "description": "A block with a map, corresponding to the custom HTML tag `<tg-map>`. The map's width and height must not exceed 10000 in total. The width and height ratio must be at most 20.",
  "fields": [
    {
      "name": "type",
      "rawType": "String",
      "required": true,
      "description": "Type of the block, always “map”"
    },
    {
      "name": "location",
      "rawType": "Location",
      "required": true,
      "description": "Location of the center of the map"
    },
    {
      "name": "zoom",
      "rawType": "Integer",
      "required": false,
      "description": "Map zoom level; 0-24"
    },
    {
      "name": "width",
      "rawType": "Integer",
      "required": false,
      "description": "Map width; 0-10000"
    },
    {
      "name": "height",
      "rawType": "Integer",
      "required": false,
      "description": "Map height; 0-10000"
    },
    {
      "name": "caption",
      "rawType": "RichBlockCaption",
      "required": false,
      "description": "Caption of the block"
    }
  ]
}
